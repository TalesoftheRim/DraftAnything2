<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
	<name>Draft Anything 2.0</name>
	<author>Talesoftherim</author>
	<description>Draft anything allows you to draft any pawnlike in the game including enemy pawns, animals, insectoids, mechanoids, anomalies. 
	If you pair this mod with Draft Directions you can change what direction they face when drafted. 
</description>
	<supportedVersions>
      <li>1.2</li>
      <li>1.3</li>
      <li>1.4</li>
	  <li>1.5</li>
       <li>1.6</li>
	   <li>1.7</li>
   </supportedVersions>
   <packageId>Talesoftherim.DraftAnything</packageId>
   <modDependencies>
		<li>
			<packageId>brrainz.harmony</packageId>
			<displayName>Harmony</displayName>
			<steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
			<downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
		</li>
	</modDependencies>
	<loadAfter>
		<li>Ludeon.RimWorld</li>
		<li>Ludeon.RimWorld.Royalty</li>
		<li>brrainz.harmony</li>
	</loadAfter>
	<incompatibleWith>
    <li>Hamrick.DraftAnything</li>
</incompatibleWith>
</ModMetaData>